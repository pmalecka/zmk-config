#define VERSION_MACRO
macro_ver: macro_ver {
compatible = "zmk,behavior-macro";
#binding-cells = <0>;
tap-ms = <30>;
wait-ms = <30>;
bindings = <&macro_tap &kp N2 &kp N0 &kp N2 &kp N5 &kp N0 &kp N6 &kp N1 &kp N2 &kp N2 &kp N0 &kp N4 &kp N8 &kp C &kp E &kp S &kp T &kp MINUS &kp D &kp O &kp N &kp G &kp MINUS &kp N9 &kp D &kp F &kp N5 &kp N4 &kp E &kp E &kp RET>;
};

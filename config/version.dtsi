#define VERSION_MACRO
macro_ver: macro_ver {
compatible = "zmk,behavior-macro";
#binding-cells = <0>;
tap-ms = <30>;
wait-ms = <30>;
bindings = <&macro_tap &kp N2 &kp N0 &kp N2 &kp N5 &kp N0 &kp N5 &kp N2 &kp N2 &kp N1 &kp N6 &kp N1 &kp N2 &kp C &kp E &kp S &kp T &kp MINUS &kp D &kp O &kp N &kp G &kp MINUS &kp F &kp E &kp N7 &kp N8 &kp E &kp N7 &kp N6 &kp RET>;
};
